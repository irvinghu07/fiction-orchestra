<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Rendered by bin/host-runnerctl install → ~/Library/LaunchAgents/.
     Fires bin/host-runner-health hourly (StartInterval 3600) + once shortly after login.
     The wrapper self-gates (skips when you're active / a job just ran / paused). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>ai.openclaw.fiction-healthcheck</string>
    <key>Comment</key><string>Fiction Orchestra — hourly first-party CLI auth health check</string>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>3600</integer>
    <key>ProcessType</key><string>Background</string>
    <key>WorkingDirectory</key><string>__REPO__</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__REPO__/bin/host-runner-health</string>
    </array>
    <key>StandardOutPath</key><string>__REPO__/orchestration/logs/health.out.log</string>
    <key>StandardErrorPath</key><string>__REPO__/orchestration/logs/health.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key><string>__HOME__</string>
      <key>TMPDIR</key><string>__TMPDIR__</string>
      <key>PATH</key><string>__PATH__</string>
      <key>NODE_EXTRA_CA_CERTS</key><string>/etc/ssl/cert.pem</string>
      <key>NODE_USE_SYSTEM_CA</key><string>1</string>
    </dict>
  </dict>
</plist>
