# NapCat compose env — lives on ARCH at orchestration/napcat/.env (gitignored).
# Copy to .env and fill in. Keep the access/webui tokens long + random.

# File-permission mapping for the mounted volumes (match the arch host user, e.g. irving).
NAPCAT_UID=1000
NAPCAT_GID=1000

# Random WebUI password — NEVER leave the default `napcat` (default has been mass-exploited).
#   openssl rand -hex 16
WEBUI_TOKEN=

# The burner QQ account number (optional pre-seed; you also scan the QR in the WebUI).
ACCOUNT=

# OneBot access token — the Bearer the openclaw-onebot plugin presents on the WS/HTTP
# connection. MUST match channels.onebot.accessToken on agent-lab-openclaw.
#   openssl rand -hex 24
NAPCAT_ACCESS_TOKEN=
