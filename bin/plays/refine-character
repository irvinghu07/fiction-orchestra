#!/usr/bin/env bash
# refine-character <name> [--nsfw] — interrogate a character card for voice,
# backstory, and consistency; propose card edits as a diff. SFW → Claude.
# --nsfw (or an .explicit.md companion) → Grok.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../lib/common.sh"; . "$HERE/../lib/context.sh"; . "$HERE/../lib/run-model.sh"; . "$HERE/../lib/workflow.sh"

NSFW=0; NAME=""
while [ "$#" -gt 0 ]; do case "$1" in
  --nsfw) NSFW=1;; -*) die "unknown flag: $1";; *) NAME="$1";;
esac; shift; done
[ -n "$NAME" ] || die "usage: refine-character <name> [--nsfw]"

# resolve card: exact, else case-insensitive contains
CARD="$ROOT/codex/characters/${NAME}.md"
if [ ! -f "$CARD" ]; then
  CARD="$(find "$ROOT/codex/characters" -iname "*${NAME}*.md" ! -name '_TEMPLATE.md' | head -1 || true)"
fi
[ -n "$CARD" ] && [ -f "$CARD" ] || die "no character card matching '$NAME' in codex/characters/"
info "Card: ${CARD#"$ROOT"/}"

ROLE=prose
{ [ "$NSFW" -eq 1 ] || is_explicit_file "$CARD"; } && ROLE=nsfw

read -r -d '' TASK <<'EOF' || true
Interrogate this character card against the rest of the bible:
- **Voice** — is the voice section sharp and distinctive? Suggest concrete tightening.
- **Consistency** — flag any contradictions with other cards, world notes, or the outline (cite them).
- **Gaps** — backstory/arc/relationship holes worth filling.
Then propose specific edits to the card as a list of `field: current → proposed` lines,
and finish with 2–3 probing questions only the author can answer.
EOF

do_workflow "refine-character" "$ROLE" "$(slugify "$NAME")" "$TASK" "$CARD"
